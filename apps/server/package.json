{
  "name": "@agent-island/server",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json && mkdir -p dist/apps/server/drizzle && cp -R drizzle/. dist/apps/server/drizzle/",
    "start": "node dist/apps/server/src/index.js",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@agent-island/shared": "*",
    "@hono/node-server": "^1.19.0",
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.10.0",
    "socket.io": "^4.8.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "drizzle-kit": "^0.31.11",
    "socket.io-client": "^4.8.0",
    "tsx": "^4.20.0"
  }
}
